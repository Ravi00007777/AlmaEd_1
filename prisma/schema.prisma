generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum ClassStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ResourceType {
  ASSIGNMENT
  TEST
  NOTE
}

enum PaymentStatus {
  PENDING
  PAID
}

// A student's account is also used by their parent to log in — there is
// no separate parent role. See ARCHITECTURE.md "Domain glossary".
model User {
  id           String   @id @default(cuid())
  role         Role
  name         String
  email        String   @unique
  phone        String?
  // Null for a student account created via Google sign-in that has never
  // set a password — credentials login must reject those, not crash.
  passwordHash String?
  createdById  String?
  createdBy    User?    @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers User[]   @relation("CreatedUsers")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teachingBatches   Batch[]         @relation("TeacherBatches")
  batchMemberships  BatchStudent[]
  uploadedResources Resource[]      @relation("ResourceUploader")
  paymentsAsStudent Payment[]       @relation("PaymentStudent")
  paymentsAsTeacher Payment[]       @relation("PaymentTeacher")
  recordedPayments  Payment[]       @relation("PaymentRecordedBy")
  notifications     Notification[]

  @@index([role])
}

// One teacher, one or more students, one shared recurring Meet link.
// Size 1 = a 1:1 class. See ARCHITECTURE.md "Domain glossary" for why
// this isn't a separate "Enrollment" table.
model Batch {
  id           String   @id @default(cuid())
  name         String
  teacherId    String
  teacher      User     @relation("TeacherBatches", fields: [teacherId], references: [id])
  meetLink     String
  scheduleNote String? // free-text schedule description for v1, e.g. "Tue/Thu 5:00pm IST"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students  BatchStudent[]
  classes   Class[]
  resources Resource[]

  @@index([teacherId])
}

model BatchStudent {
  id        String   @id @default(cuid())
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([batchId, studentId])
  @@index([studentId])
}

// One scheduled occurrence of a Batch's recurring session.
model Class {
  id          String      @id @default(cuid())
  batchId     String
  batch       Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  status      ClassStatus @default(SCHEDULED)
  reminderSentAt DateTime?
  createdAt   DateTime    @default(now())

  @@index([batchId, scheduledAt])
}

// A file a teacher shares with a batch: assignment, test, or note.
// One entity with a `type`, not separate tables — see ARCHITECTURE.md.
model Resource {
  id         String       @id @default(cuid())
  batchId    String
  batch      Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy User         @relation("ResourceUploader", fields: [uploadedById], references: [id])
  type       ResourceType
  title      String
  fileUrl    String
  // Deadline for an ASSIGNMENT/TEST to be completed by — optional since a
  // NOTE has no deadline, and even assignments/tests aren't required to set
  // one.
  dueAt      DateTime?
  createdAt  DateTime     @default(now())

  @@index([batchId, createdAt])
}

// Tracked, not processed: money moves off-platform, admin marks status.
model Payment {
  id           String        @id @default(cuid())
  studentId    String
  student      User          @relation("PaymentStudent", fields: [studentId], references: [id])
  teacherId    String
  teacher      User          @relation("PaymentTeacher", fields: [teacherId], references: [id])
  amount       Decimal       @db.Decimal(10, 2)
  status       PaymentStatus @default(PENDING)
  note         String?
  recordedById String
  recordedBy   User          @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([studentId])
  @@index([teacherId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // e.g. "CLASS_REMINDER", "RESOURCE_SHARED"
  message   String
  channel   String   @default("EMAIL")
  sentAt    DateTime @default(now())

  @@index([userId, sentAt])
}
