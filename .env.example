# ==================== DATABASE (Supabase Postgres) ====================
# Use the pooled connection string (port 6543, pgbouncer) for DATABASE_URL —
# see ARCHITECTURE.md "Tech stack" for why. DIRECT_URL is Supabase's direct
# connection, used by Prisma for migrations only.
DATABASE_URL="postgresql://postgres:password@localhost:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres"

# ==================== SUPABASE (Storage) ====================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ==================== AUTH ====================
NEXTAUTH_SECRET="your-super-secret-key-min-32-characters-long-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ==================== EMAIL (Resend) ====================
RESEND_API_KEY="re_xxx"
EMAIL_FROM="noreply@example.com"

# ==================== CRON ====================
# Sent as "Authorization: Bearer <value>" by Vercel Cron to /api/cron/*.
CRON_SECRET="a-long-random-string"

# ==================== SEED (optional, for prisma/seed.ts) ====================
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"
