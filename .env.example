# ==================== DATABASE ====================
DATABASE_URL="postgresql://postgres:password@localhost:5432/tutorconnect?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/tutorconnect?schema=public"

# ==================== AUTH ====================
NEXTAUTH_SECRET="your-super-secret-key-min-32-characters-long-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ==================== REDIS ====================
REDIS_URL="redis://localhost:6379"
# or for Upstash
# KV_REST_API_URL="https://your-redis.upstash.io"
# KV_REST_API_TOKEN="your-token"

# ==================== PAYMENTS (RAZORPAY) ====================
RAZORPAY_KEY_ID="rzp_test_xxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxx"

# ==================== GOOGLE CALENDAR/MEET ====================
GOOGLE_CALENDAR_CLIENT_ID="your-google-client-id"
GOOGLE_CALENDAR_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/google/callback"

# ==================== AI ====================
OPENAI_API_KEY="sk-xxx"
# OR
ANTHROPIC_API_KEY="sk-ant-xxx"
# OR
GEMINI_API_KEY="your-gemini-key"

# ==================== STORAGE ====================
# Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
# OR AWS S3
# AWS_ACCESS_KEY_ID="xxx"
# AWS_SECRET_ACCESS_KEY="xxx"
# AWS_REGION="ap-south-1"
# AWS_S3_BUCKET="tutorconnect"

# ==================== EMAIL ====================
RESEND_API_KEY="re_xxx"
EMAIL_FROM="noreply@tutorconnect.com"
EMAIL_REPLY_TO="support@tutorconnect.com"

# ==================== WHATSAPP (Phase 2) ====================
WHATSAPP_API_KEY="xxx"
WHATSAPP_PHONE_NUMBER_ID="xxx"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="xxx"

# ==================== MONITORING ====================
SENTRY_DSN="https://xxx@sentry.io/xxx"
SENTRY_ORG="your-org"
SENTRY_PROJECT="tutorconnect"

# ==================== PLATFORM ====================
PLATFORM_COMMISSION_PERCENT="15"
NEXT_PUBLIC_PLATFORM_NAME="TutorConnect"
NEXT_PUBLIC_SUPPORT_EMAIL="support@tutorconnect.com"